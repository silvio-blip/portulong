{
  "name": "portulong-vscode-extension",
  "displayName": "Portulong",
  "description": "Suporte nativo para linguagem Portulong",
  "version": "1.0.30",
  "publisher": "silvio",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "portulong",
        "aliases": ["Portulong", "ptg"],
        "extensions": [".ptg"],
        "configuration": "./.vscode/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "portulong",
        "scopeName": "source.ptg",
        "path": "./.vscode/syntaxes/portulong.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "portulong.run",
        "title": "Executar Ficheiro Portulong"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "portulong.run",
          "group": "navigation",
          "when": "resourceLangId == portulong"
        }
      ],
      "explorer/context": [
        {
          "command": "portulong.run",
          "group": "navigation",
          "when": "resourceLangId == portulong"
        }
      ]
    }
  }
}
