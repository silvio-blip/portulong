{
    "Escrever no Terminal": {
        "prefix": [
            "escrever",
            "imprimir",
            "esc"
        ],
        "body": [
            "escrever(\"$1\")"
        ],
        "description": "Imprime texto ou variável no terminal"
    },
    "Criar Bot Discord": {
        "prefix": [
            "discord.CriarBot",
            "botdiscord"
        ],
        "body": [
            "importar discord",
            "bot = discord.CriarBot(prefixo=\"${1:!}\")",
            "",
            "ao bot.quando_pronto:",
            "    funcao ao_ligar():",
            "        escrever(\"Bot ligado!\")",
            "",
            "bot.iniciar(\"${2:TOKEN}\")"
        ],
        "description": "Cria a estrutura base de um bot Discord"
    },
    "Comando Discord por Prefixo": {
        "prefix": [
            "comando",
            "bot.comando"
        ],
        "body": [
            "comando bot.comando(\"${1:ola}\"):",
            "    funcao responder_${1:ola}(ctx):",
            "        ctx.responder(\"${2:Olá do Portulong!}\")"
        ],
        "description": "Regista um comando por prefixo no Discord"
    },
    "Comando de Barra Discord (Slash)": {
        "prefix": [
            "barra",
            "bot.comando_barra"
        ],
        "body": [
            "barra bot.comando_barra(\"${1:ajuda}\", \"${2:Exibe ajuda}\"):",
            "    funcao responder_${1:ajuda}(ctx):",
            "        ctx.responder(\"${3:Comando de barra ativo!}\")"
        ],
        "description": "Regista um Slash Command (/comando) no Discord"
    },
    "Carregar Variáveis .env": {
        "prefix": [
            "ambiente.carregar",
            "env"
        ],
        "body": [
            "importar ambiente",
            "ambiente.carregar_ambiente(\".env\")",
            "${1:token} = ambiente.obter_ambiente(\"${2:CHAVE}\")"
        ],
        "description": "Carrega variáveis do ficheiro .env"
    },
    "Conectar Supabase": {
        "prefix": [
            "supabase",
            "base_dados.conectar_supabase"
        ],
        "body": [
            "importar base_dados",
            "db = base_dados.conectar_supabase(\"${1:URL}\", \"${2:CHAVE}\")",
            "dados = db.de(\"${3:tabela}\").selecionar()"
        ],
        "description": "Conecta ao Supabase e busca registos"
    },
    "Loop Enquanto": {
        "prefix": [
            "enquanto",
            "while"
        ],
        "body": [
            "enquanto ${1:contador <= 10}:",
            "    $0"
        ],
        "description": "Loop de repetição enquanto a condição for verdadeira"
    },
    "Interromper Loop": {
        "prefix": [
            "interromper",
            "parar",
            "break"
        ],
        "body": [
            "interromper"
        ],
        "description": "Quebra/para a execução do loop atual"
    },
    "Condicional Se / Senao": {
        "prefix": [
            "se",
            "se senao"
        ],
        "body": [
            "se ${1:condicao}:",
            "    $2",
            "senao:",
            "    $3"
        ],
        "description": "Estrutura condicional se / senão"
    },
    "Declaracao de Funcao": {
        "prefix": [
            "funcao",
            "def"
        ],
        "body": [
            "funcao ${1:nome}(${2:argumentos}):",
            "    $0"
        ],
        "description": "Declara uma nova função em Portulong"
    }
}