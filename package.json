{
    "name": "portulong",
    "displayName": "portulong",
    "description": "Suporte à linguagem portulong (.ptg) - 100% em Português de Portugal",
    "version": "1.0.0",
    "publisher": "silvio-blip",
    "icon": "images/Portulong.png",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "contributes": {
        "languages": [{
            "id": "portulong",
            "aliases": ["portulong", "Portulong"],
            "extensions": [".ptg"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "portulong",
            "scopeName": "source.portulong",
            "path": "./syntaxes/portulong.tmLanguage.json"
        }],
        "icons": {
            "fileExtensions": {
                ".ptg": "images/Portulong.png"
            },
            "fileNames": {
                "exemplo.ptg": "images/Portulong.png",
                "sistema_completo.ptg": "images/Portulong.png"
            }
        },
        "snippets": [{
            "language": "portulong",
            "path": "./snippets/portulong.json"
        }]
    }
}