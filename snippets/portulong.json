{
    "Pagina Basica": {
        "prefix": "pagina",
        "body": [
            "pagina \"${1:Minha Pagina}\"",
            "",
            "cabecalho \"${2:Titulo}\"",
            "paragrafo \"${3:Conteudo}\"",
            "",
            "estilo:",
            "body { fundo: #f5f5f5; }",
            "",
            "script:",
            "funcao ${4:minhaFuncao}():",
            "    alerta('${5:Olá!}')"
        ],
        "description": "Estrutura basica de pagina portulong"
    },
    "Componente": {
        "prefix": "componente",
        "body": [
            "componente ${1:nome}:",
            "  <div class=\"${1:nome}\">",
            "    <h2>${2:Titulo}</h2>",
            "    <p>${3:Conteudo}</p>",
            "  </div>"
        ],
        "description": "Criar componente reutilizavel"
    },
    "Rota GET": {
        "prefix": "rota-get",
        "body": [
            "rota GET /api/${1:recurso}:",
            "    resposta = {\"${2:dados}\": [${3:\"item1\", \"item2\"}]}"
        ],
        "description": "Criar rota GET API"
    },
    "Rota POST": {
        "prefix": "rota-post",
        "body": [
            "rota POST /api/${1:recurso}:",
            "    ${2:nome} = dados.get(\"${3:campo}\", \"\")",
            "    resposta = {\"sucesso\": true, \"mensagem\": \"${4:Sucesso}\"}"
        ],
        "description": "Criar rota POST API"
    },
    "Estilo": {
        "prefix": "estilo",
        "body": [
            "estilo:",
            "body { fundo: #${1:f5f5f5}; }",
            ".${2:classe} { ${3:propriedade}: ${4:valor}; }"
        ],
        "description": "Bloco de estilos CSS"
    },
    "Script": {
        "prefix": "script",
        "body": [
            "script:",
            "funcao ${1:minhaFuncao}():",
            "    alerta('${2:Olá!}')"
        ],
        "description": "Bloco de script JavaScript"
    },
    "Servidor": {
        "prefix": "servidor",
        "body": [
            "servidor:",
            "    porta ${1:8000}",
            "    host ${2:localhost}"
        ],
        "description": "Configuracao do servidor"
    }
}